# Email Service Configuration for Contact Form
#
# Primary Method: Resend API (Recommended for Vercel / Serverless)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_123456789_your_key_here

# Recipient email address (where contact form submissions will be delivered)
# Default if left unset: nasywa.fiqrihiyah@gmail.com
TO_EMAIL=nasywa.fiqrihiyah@gmail.com

# Sender email address
# Default if left unset: onboarding@resend.dev (Resend test domain)
# For production, set to a verified domain sender address, e.g. Contact Form <contact@yourdomain.com>
FROM_EMAIL=onboarding@resend.dev

# Secondary/Fallback Method: SMTP (Optional)
# If RESEND_API_KEY is not provided, the contact form can use SMTP credentials below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
